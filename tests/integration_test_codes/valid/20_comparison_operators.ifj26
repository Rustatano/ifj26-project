import ifj26.*

def yes(): Unit =
  print("Y")

def no(): Unit =
  print("N")

@main def main(): Unit =
  if 1 < 2 then
    yes()
  else
    no()
  if 2 <= 2 then
    yes()
  else
    no()
  if 3 > 2 then
    yes()
  else
    no()
  if 2 >= 3 then
    yes()
  else
    no()
  if 2 == 2 then
    yes()
  else
    no()
  if 2 != 2 then
    yes()
  else
    no()
  if "a" < "b" then
    yes()
  else
    no()
  if "b" == "b" then
    yes()
  else
    no()
  if 1 < 1.5 then
    yes()
  else
    no()
  if 2 == 2.0 then
    yes()
  else
    no()
  print("\n")
