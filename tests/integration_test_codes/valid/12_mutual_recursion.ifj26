import ifj26.*

def isEven(n: Int): Int =
  if n == 0 then
    return 1
  else
    val m = n - 1
    return isOdd(m)

def isOdd(n: Int): Int =
  if n == 0 then
    return 0
  else
    val m = n - 1
    return isEven(m)

@main def main(): Unit =
  val a = isEven(10)
  val b = isOdd(7)
  val c = isEven(7)
  show(a)
  show(b)
  show(c)

def show(n: Int): Unit =
  val s = toStr(n)
  print(s)
  print("\n")
